#!/usr/bin/env bash

set -euo pipefail

# ==============================================================================
# 1. STASH MANAGEMENT
# Ensure we only test staged changes by temporarily hiding unstaged files.
# ==============================================================================
set +e
git diff-files --quiet
is_unclean=$?
set -e

function revert_git_stash {
  >&2 echo "Unstashing uncommitted changes..."
  git stash pop -q
}

if [ -z "${NO_STASH:-}" ] && [ $is_unclean -ne 0 ]; then
  >&2 echo "Stashing uncommitted changes..."
  GIT_LITERAL_PATHSPECS=0 git stash -q --keep-index
  trap revert_git_stash EXIT
fi

# ==============================================================================
# 2. FILE GATHERING
# Grab only tracked Rust files to avoid wasting time on non-code files.
# ==============================================================================
export RUST_FILES
RUST_FILES="$(git ls-files | grep '\.rs$' || true)"

# ==============================================================================
# 3. CHECK FUNCTIONS
# ==============================================================================

function check_cargo_fmt() {
    set -euo pipefail
    # Fails if any code doesn't strictly follow standard Rust formatting
    cargo fmt --all --check
}
export -f check_cargo_fmt

function check_cargo_clippy() {
    set -euo pipefail
    # Runs the official Rust linter. 
    # The `-D warnings` flag treats all warnings as errors, blocking the commit.
    cargo clippy --all-targets --all-features -- -D warnings
}
export -f check_cargo_clippy

function check_leftover_dbg() {
    set -euo pipefail
    
    # If no rust files are tracked/found, exit cleanly
    if [ -z "$RUST_FILES" ]; then return 0; fi

    errors=""
    for path in $RUST_FILES; do
      if grep -q 'dbg!(' "$path"; then
        >&2 echo "❌ $path contains a dbg!() macro"
        errors="true"
      fi
    done

    if [ -n "$errors" ]; then
      >&2 echo "Fix the leftover dbg! macros or use --no-verify" 1>&2
      return 1
    fi
}
export -f check_leftover_dbg

# ==============================================================================
# 4. PARALLEL EXECUTION
# ==============================================================================
>&2 echo "Running Rust pre-commit checks..."

# Run all checks simultaneously.
# --halt now,fail=1 ensures that if one check fails, it immediately kills the others
# so you don't have to wait for everything to finish just to see the error.
parallel \
  --halt now,fail=1 \
  --nonotice \
::: \
    check_cargo_fmt \
    check_cargo_clippy \
    check_leftover_dbg

>&2 echo "✅ All checks passed!"
